[Unit]
Description=Raspberry Pi 5 Asset QR / RFID Scanner for %i
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/raspi_asset_iot
ExecStart=/usr/bin/python3 -u /home/%i/raspi_asset_iot/app.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
SupplementaryGroups=gpio spi i2c video
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
