# Laravel existing source contains /api/rfid-scan and /api/rfid/register.
# Change if your deployed hostname differs. Use HTTPS for remote access.
API_BASE_URL=https://tipnpasset.duckdns.org/api
# Periksa bahwa URL ini sama dengan deployment Laravel yang sekarang
API_TOKEN=GANTI_TOKEN_KUAT_SESUAI_LARAVEL
HTTP_TIMEOUT_SECONDS=6

# Enable LCD only after fitting proper I2C voltage level shifting.
LCD_ENABLED=false
LCD_ADDRESS=0x27

# Set this after confirming whether 4-leg LED is common cathode or common anode.
LED_ENABLED=false
LED_TYPE=common_anode
LED_RED_GPIO=5
LED_GREEN_GPIO=6
LED_BLUE_GPIO=13

# Off until you confirm buzzer voltage/type and build transistor driver.
BUZZER_ENABLED=false
BUZZER_GPIO=18
SWITCH_CHECK_GPIO=17
SWITCH_REGISTER_GPIO=27
RFID_RST_GPIO=25
RFID_SPI_DEVICE=0
RFID_UID_FORMAT=hex
CAMERA_ENABLED=true
RFID_ENABLED=true
CAMERA_INDEX=0

# Durable offline queue; relative to project unless changed here.
# Kosongkan untuk database di folder project/data/queue.sqlite3
# DB_PATH=/home/namauser/raspi_asset_iot/data/queue.sqlite3
PENDING_LIMIT=10000
PAIR_TIMEOUT_SECONDS=90
SCAN_REPEAT_SECONDS=3
